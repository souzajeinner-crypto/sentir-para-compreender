# Sentir para Compreender — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no repositório.

# URL base do site (para metadados e OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [OPCIONAL] Sentry DSN para monitoramento de erros
# NEXT_PUBLIC_SENTRY_DSN=

# [OPCIONAL] Analytics
# NEXT_PUBLIC_ANALYTICS_ID=
